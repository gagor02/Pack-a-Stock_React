# ========================================
# PACK-A-STOCK FRONTEND - VARIABLES DE ENTORNO
# ========================================
# IMPORTANTE: Copiar este archivo como .env.local
# NO SUBIR .env.local A GIT (ya está en .gitignore)

# ========================================
# API BACKEND
# ========================================
# Desarrollo local:
NEXT_PUBLIC_API_URL=http://localhost:8000

# Desarrollo con Docker:
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Producción:
# NEXT_PUBLIC_API_URL=https://api.tudominio.com

# ========================================
# APP SETTINGS
# ========================================
NEXT_PUBLIC_APP_NAME=Pack-a-Stock
NEXT_PUBLIC_APP_VERSION=1.0.0

# ========================================
# ENVIRONMENT
# ========================================
NODE_ENV=development
# Producción: NODE_ENV=production

# ========================================
# FEATURES FLAGS
# ========================================
NEXT_PUBLIC_ENABLE_QR_SCANNER=true
NEXT_PUBLIC_ENABLE_FACIAL_AUTH=false
NEXT_PUBLIC_ENABLE_REPORTS=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true

# ========================================
# ANALYTICS (Opcional)
# ========================================
# Google Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ========================================
# ERROR TRACKING (Opcional)
# ========================================
# Sentry
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# ========================================
# OTROS
# ========================================
# URL base de la aplicación
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Producción: https://tudominio.com
